# ---- Server ----
PORT=4000
NODE_ENV=development
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
# Time zone used for streaks, weekly quotas and daily limits
APP_TZ=Asia/Karachi
# Where uploaded drawings are stored (relative to the server folder)
UPLOAD_DIR=uploads

# ---- Database (PostgreSQL) ----
# Local: `npm run db:up` starts Postgres in Docker with these settings.
# Vercel: connect a Neon database in the Vercel dashboard; it sets both variables for you.
DATABASE_URL=postgresql://smartart:smartart@localhost:5432/smartart
DATABASE_URL_UNPOOLED=postgresql://smartart:smartart@localhost:5432/smartart

# ---- Drawing storage ----
# Leave empty to store photos in UPLOAD_DIR on disk. On Vercel, connect a Blob store and this is set for you.
BLOB_READ_WRITE_TOKEN=

# ---- First admin account (created by `npm run seed`) ----
ADMIN_EMAIL=admin@smartart.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Smart Art Admin
# Set to "true" to also create demo student/parent accounts and sample drawings
SEED_DEMO=true

# ---- AI coach ----
# "openai" = any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, llama.cpp server …)
# "mock"   = built-in demo coach (no model needed). Leave AI_BASE_URL empty to use mock.
AI_PROVIDER=openai
# Full URL of your company's model server, ending in /v1, e.g. https://ai.yourcompany.com/v1
# (Ollama: http://<host>:11434/v1 · vLLM: http://<host>:8000/v1 · LM Studio: http://<host>:1234/v1)
AI_BASE_URL=
AI_API_KEY=
# Exact model id as your server lists it at <AI_BASE_URL>/models. Must be able to read images.
AI_MODEL=qwen3-27b
# Seconds to wait for the model (a 27B model on a shared server can be slow)
AI_TIMEOUT=180
# Max length of the model's reply
AI_MAX_TOKENS=2048
# Qwen3 models 'think' before answering; true turns that off for faster replies
AI_DISABLE_THINKING=true
# Set to "true" if your server supports response_format: {type: "json_object"}
AI_JSON_MODE=false
